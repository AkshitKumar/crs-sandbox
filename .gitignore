# Secrets — never commit
.env
.env.*
!.env.example

# Scraped HTML (large, regenerable from products.jsonl + re-scrape)
data/categories/*/_raw/

# Built indices (regenerable from products.jsonl)
data/categories/*/index/

# Local documentation and cluster scripts
/docs/
/runs/

# Python
__pycache__/
*.pyc
.venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Developer-only protocol checks (not part of the shared research repository)
.local-tests/

# OS
.DS_Store

# Tooling
.idea/
.vscode/

# Result artifacts (keep summary JSONs, ignore raw transcripts to keep repo light)
results/*/raw/

# Eval outputs — generated locally per collaborator
results/
!results/.gitkeep
scripts/local/
